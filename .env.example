# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite database; no database server or Docker required.
DATABASE_URL="file:./dev.db"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Long random string used to sign session cookies (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# ─── Rate limiting ──────────────────────────────────────────────────────────
# "memory" is per process; use "upstash" for limits shared across instances.
RATE_LIMIT_DRIVER="memory"
# Required when RATE_LIMIT_DRIVER="upstash".
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Google Gemini (server-side only, never exposed to the browser) ─────────
# Leave empty to run AI screening in a clearly labelled DEMO mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ─── File storage ────────────────────────────────────────────────────────────
# "local" writes uploads to STORAGE_DIR; "s3" supports AWS S3, R2, MinIO and B2.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_MB="20"

# Required when STORAGE_DRIVER="s3". Leave endpoint blank for AWS S3.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set true for R2/MinIO and compatible path-style endpoints when needed.
S3_FORCE_PATH_STYLE="false"

# ─── Email delivery (server-side only) ───────────────────────────────────────
# "console" writes HTML previews to ./storage/outbox (default in development).
# Set "resend" or "smtp" explicitly in production; secrets are never exposed.
EMAIL_DRIVER="console"
EMAIL_FROM="CampusOS <no-reply@example.com>"

# Resend HTTP API
RESEND_API_KEY=""

# SMTP (used only when EMAIL_DRIVER="smtp"; secure=true enables TLS, commonly port 465)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Public base URL (used in exports / ID cards)
APP_URL="http://localhost:3000"
